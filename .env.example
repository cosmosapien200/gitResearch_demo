# gitResearch Environment Configuration
# Copy this file to .env and fill in your keys

# LLM Backend: "groq" or "ollama"
LLM_BACKEND=ollama

# Groq configuration (only used if LLM_BACKEND=groq)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Ollama configuration (only used if LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# GitHub API token (optional but recommended — raises rate limit from 60 to 5,000/hr)
# GITHUB_TOKEN=ghp_your_token_here
